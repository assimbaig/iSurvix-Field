# Corporate static-site browser hardening. Hostinger manages TLS and redirects.
# Do not extend HSTS to other subdomains or add script restrictions without
# checking the existing application, inline enhancements and map assets.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "upgrade-insecure-requests; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
    Header always set Strict-Transport-Security "max-age=2592000"
</IfModule>
