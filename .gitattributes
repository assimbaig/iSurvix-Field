
# Preserve document artifacts byte-for-byte.
*.pdf binary
*.docx binary
# Third-party asset SRI and SHA256 manifests require exact upstream bytes.
/backend/static/vendor/** -text whitespace=cr-at-eol
# Native export samples contain recorded byte hashes; do not change line endings.
/samples/drawings/integration-verification-20261021/*.dxf binary
/samples/drawings/integration-verification-20261021/*.json -text whitespace=cr-at-eol
/samples/drawings/release-hardening-20261021/*.dxf binary
/samples/drawings/release-hardening-20261021/*.json -text whitespace=cr-at-eol
# Corporate upload manifests bind these exact LF bytes on Windows and Linux.
/website/corporate/*.html text eol=lf
/website/corporate/*.css text eol=lf
/website/corporate/*.js text eol=lf

# Public security configuration and sitemap bind reviewed publication bytes.
/website/corporate/.htaccess text eol=lf
/website/corporate/sitemap.xml text eol=lf
