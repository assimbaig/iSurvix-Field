# Copy outside source to a private deployment directory; never commit real values.
# Read-only configuration validation must precede any approved deployment.
STAGING_HOST=staging.example.test
ISURVIX_RELEASE_ID=
# Reviewed registry@sha256 digest, or locally verified docker image ID sha256:...
ISURVIX_APP_IMAGE=
ISURVIX_NGINX_IMAGE=
ISURVIX_DATA_DIRECTORY=/var/lib/isurvix-staging
ISURVIX_SECRET_FILE=/etc/isurvix-staging/django-secret
ISURVIX_TLS_DIRECTORY=/etc/isurvix-staging/tls
ISURVIX_NGINX_CONFIG=/etc/isurvix-staging/nginx.conf
