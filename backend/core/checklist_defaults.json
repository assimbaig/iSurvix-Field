        {
          "id": "row_28",
          "label": "Photos per each of all the Tower Platforms",
          "type": "inspection",
          "required": false,
          "excel_row": 28
        },
        {
          "id": "row_29",
          "label": "Photos & statement if there any damaged/bent tower members?\n(If damage is reported, indicate the affected tower leg (A, B, C, etc.), the specific member, and the height where the damage is located)",
          "type": "inspection",
          "required": false,
          "excel_row": 29
        },
        {
          "id": "row_30",
          "label": "Photos & statement if there any missing tower members/bolts ?\n(If damage is reported, indicate the affected tower leg (A, B, C, etc.), the specific member, and the height where the missing is located)",
          "type": "inspection",
          "required": false,
          "excel_row": 30
        },
        {
          "id": "row_31",
          "label": "Photos & statement if  there any loose or rusted tower base/member, anchor bolts?\n(If damage is reported, indicate the affected tower leg (A, B, C, etc.), the specific member, and the height where the base/member is located)",
          "type": "inspection",
          "required": false,
          "excel_row": 31
        },
        {
          "id": "row_32",
          "label": "Tower Verticality in good condition",
          "type": "inspection",
          "required": false,
          "excel_row": 32
        },
        {
          "id": "row_33",
          "label": "Photos & statement if  there any visible rusted reinforcement bars?",
          "type": "inspection",
          "required": false,
          "excel_row": 33
        },
        {
          "id": "row_34",
          "label": "Photos & statement if  there any cracks or spalling on any type of foundation in the site?",
          "type": "inspection",
          "required": false,
          "excel_row": 34
        },
        {
          "id": "row_35",
          "label": "Photos & statement if  there any signs of settling/movement for any type of foundation?",
          "type": "inspection",
          "required": false,
          "excel_row": 35
        },
        {
          "id": "row_36",
          "label": "Tower Climbing Ladder are checked and secured, for Monopole inside climbing ladder photos to be captured",
          "type": "inspection",
          "required": false,
          "excel_row": 36
        },
        {
          "id": "row_37",
          "label": "Tower Cable Ladder  with clear photo of the cables, for Monopole inside climbing ladder photos to be captured",
          "type": "inspection",
          "required": false,
          "excel_row": 37
        },
        {
          "id": "row_38",
          "label": "Photos of Feeder Cables on Tower, for Monopole inside climbing ladder photos to be captured",
          "type": "inspection",
          "required": false,
          "excel_row": 38
        },
        {
          "id": "row_39",
          "label": "Clear Photos of Tower LEG Members from Bottom to Top\nTower/Pole Leg A = Azimuth Degree\nTower/Pole Leg B = Azimuth Degree\nTower/Pole Leg C = Azimuth Degree\nTower/Pole Leg D = Azimuth Degree",
          "type": "inspection",
          "required": false,
          "excel_row": 39
        },
        {
          "id": "row_40",
          "label": "Photo of all each RF antenna/RRU/RRH label or other operators and also take its cables.\n(RFM/RRH/RRU installed in Tower Leg)\n(Name of RFM/RRH/RRU  = Tower/Pole Leg A)",
          "type": "inspection",
          "required": false,
          "excel_row": 40
        },
        {
          "id": "row_41",
          "label": "If label not found on antenna/RFM/RRU/RRH measurements (LxWxH) photos",
          "type": "inspection",
          "required": false,
          "excel_row": 41
        },
        {
          "id": "row_42",
          "label": "Clear zoom-in photos of each Antenna, radio and other equipment on tower and with full face",
          "type": "inspection",
          "required": false,
          "excel_row": 42
        },
        {
          "id": "row_43",
          "label": "On photos identify what  Sector-A, Sector-B, & Sector-C for antenna/RFM/RRH/RRU",
          "type": "inspection",
          "required": false,
          "excel_row": 43
        },
        {
          "id": "row_44",
          "label": "Installed base Microwave antenna take the label on back zoom clear photos and take the antenna cables also",
          "type": "inspection",
          "required": false,
          "excel_row": 44
        },
        {
          "id": "row_45",
          "label": "Installed base Microwave antenna Size (Diameter-0.3/0.6/1.2/1.8m) and Installed base height",
