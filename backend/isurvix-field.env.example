# Copy to /etc/isurvix-field.env with owner-only permissions on the chosen VPS.
# Generate a NEW private key; never copy the development key or commit this file
# after inserting real environment values.
DJANGO_SETTINGS_MODULE=checklist.settings
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_PRIVATE_KEY_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=field.example.com
DEBUG=False
ISURVIX_LOCAL_AI_ENABLED=False
ISURVIX_AI_MODEL=qwen3.5:4b
